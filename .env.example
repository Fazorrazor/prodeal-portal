# =============================================================================
# Pro Deal Portal — Environment Variable Contract (Example Template)
# Copy to .env.local for local development. NEVER commit real secrets.
# Validated by lib/env.ts.
# =============================================================================

# --- Core: Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Security: Dedicated Admin Subdomain Isolation (Recommended in Prod) ---
ADMIN_SUBDOMAIN_HOST=desk.prodealindustries.com
NEXT_PUBLIC_ADMIN_SUBDOMAIN_HOST=desk.prodealindustries.com

# --- Rate Limiting & Abuse Protection: Upstash Redis (Recommended in Prod) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# --- Transactional & Security Alert Emails: Resend ---
RESEND_API_KEY=your-resend-api-key
SECURITY_ALERT_EMAIL=security@example.com
SECURITY_ALERT_FROM="Prodeal Security <alerts@prodealindustries.com>"
ENABLE_DEV_SECURITY_EMAILS=false

# --- Scheduled Jobs & Origin Protection ---
CRON_SECRET=generate-a-32-byte-random-secret
CLOUDFLARE_ORIGIN_SECRET=

# --- WhatsApp Business / Twilio Dispatch (Optional if inactive) ---
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
